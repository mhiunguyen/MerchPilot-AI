# Copy this file to .streamlit/secrets.toml only when you need private settings.
# Never commit the real secrets.toml file.
#
# Public feedback persistence is intentionally optional. The MVP falls back to
# session-only feedback with a CSV download when no durable store is configured.
#
# Example future Google Sheets configuration:
# [google_sheets]
# spreadsheet_id = "replace-me"
# service_account_json = """{"type":"service_account", "...":"..."}"""

