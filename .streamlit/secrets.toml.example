# Copy this file to .streamlit/secrets.toml only when you need private settings.
# Never commit the real secrets.toml file.
#
# Feedback and Decision Log persistence through deployment/google_apps_script.gs.
# Use the same long token in Apps Script Properties and Streamlit Secrets.
[google_sheets]
webhook_url = "https://script.google.com/macros/s/replace-me/exec"
webhook_token = "replace-with-a-long-random-secret"
